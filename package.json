{
  "homepage": "https://yashrajput.in",
  "name": "yash-rajput-portfolio",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "predeploy": "npm run build",
    "start": "node fetch.js && react-scripts start",
    "build": "node fetch.js && react-scripts build",
    "deploy": "gh-pages -b master -d build",
    "format": "prettier --write \"./src/**/*.{js,jsx,css}\"",
    "check-format": "prettier -c \"./src/**/*.{js,jsx,css}\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [">0.3%", "not ie 11", "not dead", "not op_mini all"],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "dotenv": "^8.2.0",
    "gh-pages": "^6.0.0",
    "prettier": "^2.3.1"
  }
}
